  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:tailwind": "npx @tailwindcss/cli -i ./assets/css/input.css -o ./assets/css/output.css --minify",
    "watch:tailwind": "npx @tailwindcss/cli -i ./assets/css/input.css -o ./assets/css/output.css --watch",
    "build:scss": "sass ./assets/scss/pages/home.scss ./assets/css/main.css",
    "watch:scss": "chokidar \"assets/scss/**/*.scss\" -c \"sass ./assets/scss/pages/home.scss ./assets/css/main.css\"",
    "build:js": "esbuild assets/js/entry-home.js --bundle --minify --outfile=assets/js/dist/entry-home.js",
    "watch:js": "esbuild assets/js/entry-home.js --bundle --outfile=assets/js/dist/entry-home.js --watch"
  },
